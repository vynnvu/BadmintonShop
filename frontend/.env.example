# Base URL that httpClient calls
VITE_API_URL=/api
# Optional direct Catalog backend URL; leave unset to use the Vite proxy
# Set to http://localhost:8080/api to make browser requests go directly to Java
# VITE_CATALOG_API_URL=http://localhost:8080/api
# All APIs use Spring Boot; Vite only proxies requests during local development.
# Spring Boot backend address for the Vite proxy
VITE_BACKEND_URL=http://localhost:8080

# Inventory always calls the Java backend directly; includes /api.
# VITE_INVENTORY_API_URL=http://localhost:8080/api
# Optional public FastShip tracking portal. Unset in production hides the external link.
# VITE_FASTSHIP_PORTAL_URL=https://tracking.example.com/track
