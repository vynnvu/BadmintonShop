# =====================================================================
# Database Configuration (SQL Server)
# =====================================================================
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=badminton_shop;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=sa

# =====================================================================
# payOS Payment Gateway & Webhook Credentials
# Lấy từ: https://my.payos.vn/ -> Kênh thanh toán (API Credentials)
# =====================================================================
# 1. Mã định danh Client (Client ID)
PAYOS_CLIENT_ID=your_payos_client_id_here

# 2. Khóa API (API Key) dùng để tạo link thanh toán VietQR
PAYOS_API_KEY=your_payos_api_key_here

# 3. Khóa kiểm tra chữ ký số (Checksum Key) - Dùng xác thực Webhook HMAC-SHA256
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# (Tùy chọn) Webhook URL công khai khi chạy test với ngrok / localtunnel / production
# PAYOS_WEBHOOK_URL=https://your-domain.ngrok-free.app/api/payments/payos/webhook

# =====================================================================
# Google Mail SMTP
# =====================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password


